rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Moderators are listed by hand in admins/{uid} (Firebase Console only).
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidStatus(s) { return s in ['en_attente', 'en_cours', 'résolu']; }

    // ---------- Moderators ----------
    match /admins/{uid} {
      allow get: if isOwner(uid);          // a user can only check whether they are a moderator
      allow list, write: if false;
    }

    // ---------- User profiles (personal data: name, email) ----------
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['prenom', 'nom', 'email', 'createdAt'])
        && request.resource.data.prenom is string && request.resource.data.prenom.size() <= 50
        && request.resource.data.nom is string && request.resource.data.nom.size() <= 50
        && request.resource.data.email is string && request.resource.data.email.size() <= 120;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prenom', 'nom'])
        && request.resource.data.prenom is string && request.resource.data.prenom.size() <= 50
        && request.resource.data.nom is string && request.resource.data.nom.size() <= 50;
      allow delete: if false;
    }

    // ---------- Reports (no names or photos; readable by signed-in users for the public statistics) ----------
    match /reports/{reportId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['latitude', 'longitude', 'userId',
             'timestamp', 'statut', 'ville', 'quartier', 'hasPhoto'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.statut == 'en_attente'
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= 30 && request.resource.data.latitude <= 38
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= 7 && request.resource.data.longitude <= 12
        && request.resource.data.timestamp is string
        && request.resource.data.ville is string && request.resource.data.ville.size() <= 60
        && (!('quartier' in request.resource.data)
            || (request.resource.data.quartier is string && request.resource.data.quartier.size() <= 60))
        && request.resource.data.hasPhoto is bool;

      // Only moderators update a report: its status and the campaign created from it.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'updatedAt', 'campaignId'])
        && isValidStatus(request.resource.data.statut)
        && request.resource.data.updatedAt is string
        && (!('campaignId' in request.resource.data) || request.resource.data.campaignId is string);

      allow delete: if isAdmin();
    }

    // ---------- Report photos (private: only moderators can see them) ----------
    match /reportPhotos/{reportId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userId', 'photo', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.photo is string
        && request.resource.data.photo.matches('^data:image/jpeg;base64,.*')
        && request.resource.data.photo.size() < 900000
        && request.resource.data.createdAt is string;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- Campaigns ----------
    match /campaigns/{campaignId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();

      // Moderators can edit anything; citizens can only add themselves once,
      // to an open campaign that is not full.
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.get('statut', 'ouvert') != 'termine'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
        && request.resource.data.participants.size() == resource.data.participants.size() + 1
        && request.resource.data.participants.toSet().difference(resource.data.participants.toSet())
             == [request.auth.uid].toSet()
        && request.resource.data.participants.size() <= resource.data.get('maxParticipants', 1000)
      );
    }
  }
}
